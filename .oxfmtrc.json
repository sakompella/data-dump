{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"ignorePatterns": [
		".agent/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".continue/**",
		".cursor/**",
		".gemini/**",
		".opencode/**",
		".pi/**",
		".roo/**",
		".windsurf/**",
		".audit/**",
		"dist/**",
		".wrangler/**",
		"worker-configuration.d.ts",
		"docs/_*.md",
		"tools/oxlint/anti-slop/**",
		"pnpm-lock.yaml",
		"skills-lock.json",
		"README.md"
	]
}
