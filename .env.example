# Where rambles and thoughts are stored as Markdown files. Default: ./data
DATA_DIR=./data

# If set, every page asks for this password once per browser.
# If unset, the app is open to anyone who can reach it (a warning is logged).
APP_PASSWORD=

# Model used to split rambles into thoughts. A ChatGPT account connected on
# /connect is used first, then OPENAI_API_KEY. With neither, each ramble
# becomes one thought.
# CHATGPT_MODEL is required once ChatGPT is connected (for example gpt-5-mini;
# which models a ChatGPT plan accepts is up to OpenAI).
CHATGPT_MODEL=

# OPENAI_MODEL is required when OPENAI_API_KEY is set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Used by `pnpm start` (adapter-node). ORIGIN must match the URL you open,
# or form posts are rejected.
PORT=3000
ORIGIN=http://localhost:3000
