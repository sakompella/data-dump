# Where rambles and thoughts are stored as Markdown files. Default: ./data
DATA_DIR=./data

# If set, every page asks for this password once per browser.
# If unset, the app is open to anyone who can reach it (a warning is logged).
APP_PASSWORD=

# Model used to split rambles into thoughts. Without a key, each ramble
# becomes one thought. OPENAI_MODEL is required when OPENAI_API_KEY is set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Used by `bun run start` (adapter-node). ORIGIN must match the URL you open,
# or form posts are rejected.
PORT=3000
ORIGIN=http://localhost:3000
