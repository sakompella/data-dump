{
	"name": "data-dump",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"types": "wrangler types --strict-vars false",
		"check": "pnpm run types && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"hono": "^4.13.11",
		"jose": "^6.2.12",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.62.0",
		"@oxlint/plugins": "1.86.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.3",
		"fast-check": "^4.10.2",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"wrangler": "^4.143.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.3.4"
